{
  "pluginAlias": "Porsche",
  "pluginType": "platform",
  "singular": true,
  "customUi": true,
  "headerDisplay": "Adds your Porsche to Apple Home. **First run: sign in above with your Porsche ID** (email, password, and a captcha image if prompted) — after that the plugin runs headless via the refresh token. You can also use the `porsche-auth` CLI. See the README for details.",
  "footerDisplay": "Unofficial, reverse-engineered API. If you hit \"tokens lost\" errors, run `porsche-auth` again.",
  "schema": {
    "type": "object",
    "properties": {
      "vehicleName": {
        "title": "Display name",
        "type": "string",
        "required": true,
        "default": "Porsche"
      },
      "language": {
        "title": "Language",
        "type": "string",
        "required": false,
        "default": "en",
        "description": "Language of the HomeKit tile names.",
        "oneOf": [
          { "title": "English", "enum": ["en"] },
          { "title": "German / Deutsch", "enum": ["de"] }
        ]
      },
      "vin": {
        "title": "VIN (empty = first vehicle)",
        "type": "string",
        "required": false
      },
      "vehicleModel": {
        "title": "Model (HomeKit device details)",
        "type": "string",
        "required": false,
        "default": "Porsche",
        "description": "Shown as the Model in each accessory's details (e.g. Taycan, Macan)."
      },
      "detailLevel": {
        "title": "Tile scope",
        "type": "string",
        "required": false,
        "default": "essential",
        "description": "\"Essential\" shows only the most important everyday tiles. \"Full\" shows the complete cockpit (all ~55 tiles).",
        "oneOf": [
          { "title": "Essential (recommended)", "enum": ["essential"] },
          { "title": "Full (everything)", "enum": ["full"] }
        ]
      },
      "vehicleType": {
        "title": "Drivetrain",
        "type": "string",
        "required": false,
        "default": "ev",
        "description": "Controls the energy tiles. \"Electric\" = charge level/range/charging. \"Combustion\" = fuel level/range. \"Plug-in hybrid\" = both. Note: only electric (Taycan) is live-tested.",
        "oneOf": [
          { "title": "Electric (EV)", "enum": ["ev"] },
          { "title": "Combustion", "enum": ["combustion"] },
          { "title": "Plug-in hybrid (PHEV)", "enum": ["phev"] }
        ]
      },
      "spin": {
        "title": "Porsche S-PIN (for unlocking)",
        "type": "string",
        "required": false,
        "description": "4-digit security PIN from the My Porsche app. Only needed for UNLOCKING via Apple Home. Leave empty = the lock can only lock. Stored in plain text in the Homebridge config."
      },
      "pollIntervalMinutes": {
        "title": "Poll interval (min, at least 10)",
        "type": "integer",
        "required": false,
        "default": 15,
        "minimum": 10
      },
      "homeLat": {
        "title": "Home latitude (for 'Car at home')",
        "type": "number",
        "required": false,
        "default": 0
      },
      "homeLon": {
        "title": "Home longitude",
        "type": "number",
        "required": false,
        "default": 0
      },
      "homeRadiusM": {
        "title": "Home radius (meters)",
        "type": "integer",
        "required": false,
        "default": 150,
        "minimum": 10
      },
      "defaultTargetTemp": {
        "title": "Pre-conditioning target temperature °C",
        "type": "number",
        "required": false,
        "default": 21
      },
      "tempMin": {
        "title": "Min. target temperature °C",
        "type": "number",
        "required": false,
        "default": 15
      },
      "tempMax": {
        "title": "Max. target temperature °C",
        "type": "number",
        "required": false,
        "default": 30
      },
      "tempStep": {
        "title": "Temperature step °C",
        "type": "number",
        "required": false,
        "default": 0.5
      },
      "lowBatteryThreshold": {
        "title": "'Battery low' warning threshold %",
        "type": "integer",
        "required": false,
        "default": 20,
        "minimum": 0,
        "maximum": 100
      },
      "serviceWarnKm": {
        "title": "Service warning below remaining distance (km)",
        "type": "integer",
        "required": false,
        "default": 2000,
        "minimum": 0
      },
      "tireDiffThreshold": {
        "title": "Tire pressure warning threshold (bar)",
        "type": "number",
        "required": false,
        "default": 0.3,
        "minimum": 0
      },
      "staleMinutes": {
        "title": "Data considered stale after (min)",
        "type": "integer",
        "required": false,
        "default": 30,
        "minimum": 1
      },
      "heatingAutoOffMinutes": {
        "title": "Heating auto-off (min)",
        "type": "integer",
        "required": false,
        "default": 15,
        "minimum": 1
      },
      "honkAutoOffSeconds": {
        "title": "Honk/flash auto-off (sec)",
        "type": "integer",
        "required": false,
        "default": 3,
        "minimum": 1
      },
      "exposeClimateZones": {
        "title": "Show climate zone sensors",
        "type": "boolean",
        "required": false,
        "default": true
      },
      "exposeTheftSensor": {
        "title": "Show theft sensor",
        "type": "boolean",
        "required": false,
        "default": false
      }
    }
  },
  "form": [
    "vehicleName",
    "language",
    "vin",
    "vehicleModel",
    "detailLevel",
    "vehicleType",
    { "key": "spin", "type": "password" },
    {
      "type": "fieldset",
      "title": "Polling & Climate",
      "expandable": true,
      "expanded": true,
      "items": [
        "pollIntervalMinutes",
        "defaultTargetTemp",
        "tempMin",
        "tempMax",
        "tempStep"
      ]
    },
    {
      "type": "fieldset",
      "title": "Location \"Car at home\"",
      "expandable": true,
      "expanded": false,
      "items": [
        "homeLat",
        "homeLon",
        "homeRadiusM"
      ]
    },
    {
      "type": "fieldset",
      "title": "Warnings & Thresholds",
      "expandable": true,
      "expanded": false,
      "items": [
        "lowBatteryThreshold",
        "serviceWarnKm",
        "tireDiffThreshold",
        "staleMinutes"
      ]
    },
    {
      "type": "fieldset",
      "title": "Comfort Timers & Sensors",
      "expandable": true,
      "expanded": false,
      "items": [
        "heatingAutoOffMinutes",
        "honkAutoOffSeconds",
        "exposeClimateZones",
        "exposeTheftSensor"
      ]
    }
  ]
}
